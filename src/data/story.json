{
  "speakers": [
    { "id": "timo", "name": "Timo", "color": "#c58cff", "face": "timo" },
    { "id": "swimply", "name": "Swimply", "color": "#f2d7a6", "face": "hero", "bubble": true }
  ],
  "scripts": [
    {
      "id": "intro",
      "map": "spawn",
      "unless": ["introSeen", "enteredMindscape"],
      "steps": [
        { "control": false },
        { "pose": "asleep" },
        { "eyes": "closed" },
        { "wait": 1.5 },
        { "shake": 5 },
        { "wait": 1 },
        { "say": "timo", "face": "timo_sad", "text": "please..." },
        { "say": "timo", "face": "timo_sad", "text": "i need you to wake up" },
        { "shake": 3 },
        { "eyes": "open", "time": 3.5 },
        { "say": "timo", "face": "timo_shocked", "text": "holy shit! it actually worked!" },
        { "pose": "stand", "time": 4 },
        { "say": "timo", "face": "timo_laugh", "text": "im unstoppable!" },
        { "say": "timo", "face": "timo_happy", "text": "it is I, Timo the wise! and who might you be?" },
        { "say": "swimply", "text": "..." },
        { "say": "timo", "face": "timo_laugh", "text": "...Swimply? thats a dumb name" },
        { "say": "swimply", "text": "......" },
        { "say": "timo", "face": "timo_mad", "text": "no its not! i swear, ill kill you back to dead again, dont test me." },
        { "wait": 1 },
        { "say": "timo", "face": "timo_sad", "text": "alright, sorry for saying its a dumb name." },
        { "say": "timo", "text": "now if you want to survive, we gotta get the heck outta here" },
        { "say": "timo", "text": "your armor puts you at a rank 2 weapons conjurer, you still got the sauce?" },
        { "control": true },
        { "waitFor": "move" },
        { "wait": 1.5 },
        { "say": "timo", "face": "timo_shocked", "text": "oh wow brother you look rough" },
        { "say": "timo", "text": "do you even remember how to use magic?" },
        { "timo": "bow_pedestal" },
        { "say": "timo", "text": "come here and touch the void bow." },
        { "say": "timo", "face": "timo_happy", "text": "maybe a little magic memory will help." },
        { "wait": 1 },
        { "say": "timo", "text": "its kind of like muscle memory, but magic" },
        { "flag": "introSeen" }
      ]
    },
    {
      "id": "mindscape-tutorial",
      "map": "mindscape",
      "unless": "dodgeTaught",
      "steps": [
        { "wait": 0.6 },
        { "tutorial": "Space to dodge. Click to shoot." },
        { "flag": "dodgeTaught" }
      ]
    },
    {
      "id": "back-from-mindscape",
      "map": "spawn",
      "if": "mindscapeCleared",
      "unless": "teleportTaught",
      "steps": [
        { "wait": 0.8 },
        { "say": "timo", "face": "timo_happy", "text": "those juices flowing yet?" },
        { "tutorial": "Right click to teleport" },
        { "waitFor": "teleport" },
        { "say": "timo", "face": "timo_laugh", "text": "oh heck yeah, now lets get out of this burning wing!" },
        { "say": "timo", "text": "you should be able to teleport through the lava if you're quick enough" },
        { "flag": "teleportTaught" }
      ]
    }
  ]
}

{
  "speakers": [
    { "id": "timo", "name": "Timo", "color": "#c58cff", "face": "timo", "voice": "voice_blip", "pitch": 1.5 },
    { "id": "swimply", "name": "Swimply", "color": "#f2d7a6", "face": "hero", "bubble": true, "voice": "voice_blip", "pitch": 0.8, "lineSounds": ["swimply_dots_a", "swimply_dots_b"] }
  ],
  "scripts": [
    {
      "id": "intro",
      "map": "spawn",
      "unless": ["introSeen", "enteredMindscape"],
      "steps": [
        { "control": false },
        { "pose": "asleep" },
        { "eyes": "closed" },
        { "wait": 1.5 },
        { "shake": 5 },
        { "wait": 1 },
        { "say": "timo", "face": "timo_sad", "text": "please..." },
        { "say": "timo", "face": "timo_sad", "text": "i need you to wake up" },
        { "shake": 3 },
        { "eyes": "open", "time": 3.5 },
        { "say": "timo", "face": "timo_happy", "text": "holy shit! it actually worked!" },
        { "pose": "stand", "frames": [{ "frame": 0, "time": 0.7 }, { "frame": 1, "time": 0.9 }, { "frame": 2, "time": 0.8 }, { "frame": 1, "time": 0.7 }, { "frame": 3, "time": 0.6 }] },
        { "say": "timo", "face": "timo_happy", "text": "im unstoppable!" },
        { "say": "timo", "face": "timo_happy", "text": "it is I, Timo the wise! and who might you be?" },
        { "say": "swimply", "text": "..." },
        { "say": "timo", "face": "timo_laugh", "text": "...Swimply? thats a dumb name" },
        { "say": "swimply", "text": "......" },
        { "say": "timo", "face": "timo_mad", "text": "*gasp* wtf no its not! uncalled for, man" },
        { "wait": 2 },
        { "say": "timo", "face": "timo_sad", "text": "ALRIGHT! I'M SORRY" },
        { "wait": 2 },
        { "say": "timo", "face": "timo_serious", "text": "ahem... enough of this, we gotta get the fluff outta here, dawg, that fire is gonna spread" },
        { "wait": 2 },
        { "say": "timo", "face": "timo_shocked", "text": "your armor, that puts you at a.... rank 2 conjurer?" },
        { "say": "timo", "face": "timo_shocked", "text": "very nice, you still got the sauce?" },
        { "control": true },
        { "tutorial": "WASD to move" },
        { "waitFor": "move" },
        { "wait": 1.5 },
        { "say": "timo", "face": "timo_shocked", "text": "oh wow brother you look rough" },
        { "say": "timo", "face": "timo_shocked", "text": "do you even remember how to use magic?" },
        { "timo": "bow_pedestal" },
        { "say": "timo", "text": "come here and touch the void bow." },
        { "say": "timo", "face": "timo_happy", "text": "maybe a little magic memory will help." },
        { "wait": 1 },
        { "say": "timo", "text": "its kind of like muscle memory, but magic" },
        { "flag": "introSeen" }
      ]
    },
    {
      "id": "mindscape-tutorial",
      "map": "mindscape",
      "unless": "dodgeTaught",
      "steps": [
        { "wait": 0.6 },
        { "tutorial": "Space to dodge. Click to shoot." },
        { "flag": "dodgeTaught" }
      ]
    },
    {
      "id": "back-from-mindscape",
      "map": "spawn",
      "if": "mindscapeCleared",
      "unless": "teleportTaught",
      "steps": [
        { "wait": 0.8 },
        { "say": "timo", "face": "timo_shocked", "text": "those juices flowing yet?" },
        { "tutorial": "Right click to teleport" },
        { "waitFor": "teleport" },
        { "say": "timo", "face": "timo_happy", "text": "nice! if you teleport quickly enough, you should be able to go through the fire." },
        { "flag": "teleportTaught" }
      ]
    },
    {
      "id": "throne-hub",
      "map": "throne",
      "if": "mindscapeCleared",
      "unless": "throneSeen",
      "steps": [
        { "control": false },
        { "wait": 0.5 },
        { "shake": 10 },
        { "sound": "explosion_medium" },
        { "flag": "throneSealed" },
        { "wait": 1.5 },
        { "say": "timo", "face": "timo_serious", "text": "oh heck, that was close!" },
        { "wait": 2 },
        { "say": "timo", "face": "timo_idle", "text": "golly i am so tired. i cant imagine that was good for me" },
        { "say": "swimply", "text": "..." },
        { "say": "timo", "face": "timo_mad", "text": "oh well im SOO happy YOU feel good! no thanks to me, asshole!" },
        { "say": "swimply", "text": "....." },
        { "say": "timo", "face": "timo_sad", "text": "well I had to use a portion of my soul! i dont think i'll ever be at full strength again" },
        { "say": "swimply", "text": "...." },
        { "say": "timo", "face": "timo_sad", "text": "well i didn't really have a choice. once that lady got a hold of the fire fairy..." },
        { "say": "timo", "face": "timo_serious", "text": "you know what, take a walk with me" },
        { "walk": "throne" },
        { "wait": 0.5 },
        { "say": "timo", "face": "timo_serious", "text": "do you have any idea who used to sit in this throne?" },
        { "say": "swimply", "text": "..." },
        { "say": "timo", "face": "timo_laugh", "text": "me neither!" },
        { "say": "timo", "face": "timo_serious", "text": "but i do know they're gone for good" },
        { "say": "timo", "face": "timo_serious", "text": "and these pedestals you see here?" },
        { "say": "timo", "face": "timo_serious", "text": "these would contain their Holy Vestiges." },
        { "say": "timo", "face": "timo_serious", "text": "artifacts that grant its user divine strength and abilities." },
        { "say": "timo", "face": "timo_serious", "text": "over the months, they've been taken from this room and are being used all over the castle and beyond" },
        { "say": "timo", "face": "timo_serious", "text": "that is...." },
        { "say": "timo", "face": "timo_happy", "text": "except one." },
        { "say": "timo", "face": "timo_happy", "text": "ive always been the strongest. strong enough to finally wake up" },
        { "say": "timo", "face": "timo_sad", "text": "but even after having awoken, i've come to realize, i cannot do this alone" },
        { "say": "timo", "face": "timo_sad", "text": "without a proper host, im just a talking ball" },
        { "say": "timo", "face": "timo_happy", "text": "but that's where you come in" },
        { "say": "timo", "face": "timo_happy", "text": "i had been prepping your revival for weeks and was nearing completion" },
        { "say": "timo", "face": "timo_sad", "text": "until that bitch got her hands on the fire fairy and started burning down the place!" },
        { "say": "timo", "face": "timo_sad", "text": "so i had to... speed up the process and implement some of my soul into yours" },
        { "wait": 1 },
        { "say": "swimply", "text": "..." },
        { "wait": 2 },
        { "say": "timo", "face": "timo_serious", "text": "sigh. yeah, no problem." },
        { "say": "timo", "face": "timo_serious", "text": "but, now you owe me." },
        { "say": "timo", "face": "timo_serious", "text": "we're taking this castle for our own. AND we're getting those vestiges back" },
        { "vestige": "doomsday" },
        { "wait": 2.5 },
        { "say": "timo", "face": "timo_serious", "text": "use my power. it's nothing compared to what it once was, but it should be more than enough" },
        { "control": true },
        { "flag": "throneSeen" }
      ]
    }
  ]
}
